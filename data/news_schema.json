{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "INSARAG 新闻知识单元元数据规范",
  "description": "面向知识库构建的单条新闻 JSON 元数据模型。核心思想：来源可追溯（source/provenance）、内容可计算（body/knowledge）、语义可扩展（entities/translation）、多语可对齐（translation/alignment）。",
  "type": "object",
  "required": [
    "schema_version", "doc_id", "record_type", "source", "title_en",
    "summary_en", "body", "published_at", "entities", "knowledge", "provenance"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "string", "description": "元数据规范版本号" },
    "doc_id": { "type": "string", "pattern": "^INSARAG-NEWS-\\d+$", "description": "全局唯一文档标识，取自 WordPress 文章 ID，保证跨批次稳定" },
    "record_type": { "const": "news", "description": "记录类型；后续可扩展 term / corpus_pair / report" },
    "seq": { "type": "integer", "description": "本批次内的顺序号" },
    "source": {
      "type": "object",
      "description": "来源层：回答“这条数据从哪来、是否可信”",
      "required": ["publisher", "site", "section", "canonical_url", "wp_post_id", "language"],
      "properties": {
        "publisher": { "type": "string" },
        "publisher_full": { "type": "string" },
        "site": { "type": "string", "format": "uri" },
        "section": { "type": "string", "description": "站点栏目：Global News / Asia-Pacific News / AEME News / IEC/R News" },
        "canonical_url": { "type": "string", "format": "uri", "description": "原文规范链接，用于来源回溯" },
        "wp_post_id": { "type": "integer", "description": "WordPress 文章主键" },
        "language": { "type": "string", "description": "原文语言代码（BCP-47）" },
        "license_note": { "type": "string", "description": "版权与使用范围说明" }
      }
    },
    "title_en": { "type": "string", "minLength": 1 },
    "title_zh": { "type": "string", "description": "中文标题（机器翻译，用于中文检索与双语展示）" },
    "slug": { "type": "string" },
    "summary_en": { "type": "string" },
    "summary_zh": { "type": "string" },
    "body": {
      "type": "object",
      "description": "内容层：结构化正文，段落数组便于切片与向量化",
      "properties": {
        "paragraphs_en": { "type": "array", "items": { "type": "string" } },
        "paragraphs_zh": { "type": "array", "items": { "type": "string" } },
        "plain_text_en": { "type": "string" },
        "plain_text_zh": { "type": "string" },
        "char_count_en": { "type": "integer" },
        "char_count_zh": { "type": "integer" }
      }
    },
    "published_at": { "type": "string", "format": "date-time" },
    "modified_at": { "type": "string", "format": "date-time" },
    "authors": { "type": "array", "items": { "type": "string" } },
    "categories": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "entities": {
      "type": "object",
      "description": "语义层：实体抽取结果，支撑结构化筛选与知识图谱扩展",
      "properties": {
        "countries": { "type": "array", "items": { "type": "string" } },
        "regions": { "type": "array", "items": { "type": "string" } },
        "organizations": { "type": "array", "items": { "type": "string" } },
        "usar_teams": { "type": "array", "items": { "type": "string" }, "description": "USAR 队伍代码，如 GER-01 / EGY-01" },
        "themes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "const": "image" },
          "url": { "type": "string" },
          "local_path": { "type": "string" },
          "alt": { "type": "string" },
          "caption": { "type": "string" },
          "downloaded_bytes": { "type": "integer" }
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "description": "pdf 等附件类型" },
          "title": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "knowledge": {
      "type": "object",
      "description": "知识层：切片与向量索引状态，供 RAG 流水线读写",
      "properties": {
        "chunk_strategy": { "type": "string" },
        "chunks": { "type": "integer" },
        "embedding_model": { "type": "string" },
        "embedding_dim": { "type": "integer" },
        "indexed": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "description": "溯源层：采集时间、解析器、内容指纹，保证可复现",
      "properties": {
        "crawled_at": { "type": "string", "format": "date-time" },
        "crawler": { "type": "string" },
        "http_status": { "type": "integer" },
        "parser": { "type": "string" },
        "content_sha256": { "type": "string", "description": "英文正文 SHA-256，用于检测官网内容变更" },
        "source_snapshot": { "type": "string", "description": "原始 API 响应快照路径" },
        "translation_status": { "type": "string" }
      }
    },
    "translation": {
      "type": "object",
      "description": "对齐层：记录翻译方法、时间与 1:1 句级对齐策略",
      "properties": {
        "method": { "type": "string" },
        "alignment": { "type": "string" },
        "translated_at": { "type": "string" }
      }
    }
  }
}
